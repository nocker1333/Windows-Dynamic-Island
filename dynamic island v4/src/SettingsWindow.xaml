<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
Title="Настройки Dynamic Island" Width="540" Height="740" MinWidth="440" MinHeight="520"
WindowStartupLocation="CenterScreen" Background="#FF1C1C1E" Foreground="White" ResizeMode="CanResizeWithGrip">
<Window.Resources>
  <SolidColorBrush x:Key="Card" Color="#FF2C2C2E"/>
  <SolidColorBrush x:Key="Muted" Color="#FF9A9AA0"/>

  <Style x:Key="Switch" TargetType="ToggleButton">
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border x:Name="Track" Width="44" Height="24" CornerRadius="12" Background="#FF48484A">
            <Ellipse x:Name="Knob" Width="20" Height="20" Fill="White" HorizontalAlignment="Left" Margin="2,0,0,0"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Track" Property="Background" Value="#FF30D158"/>
              <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
              <Setter TargetName="Knob" Property="Margin" Value="0,0,2,0"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.4"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Seg" TargetType="RadioButton">
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Border x:Name="B" Background="#FF3A3A3C" CornerRadius="8" Padding="12,8" Margin="0,0,8,6">
            <TextBlock x:Name="T" Text="{TemplateBinding Content}" Foreground="#FFE5E5EA" FontSize="13" HorizontalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="B" Property="Background" Value="#FF48484A"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="B" Property="Background" Value="#FF0A84FF"/>
              <Setter TargetName="T" Property="Foreground" Value="White"/>
              <Setter TargetName="T" Property="FontWeight" Value="SemiBold"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Tab" TargetType="RadioButton">
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Border x:Name="B" Background="Transparent" CornerRadius="8" Padding="14,7" Margin="0,0,4,0">
            <TextBlock x:Name="T" Text="{TemplateBinding Content}" Foreground="#FF9A9AA0" FontSize="13" FontWeight="SemiBold"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="T" Property="Foreground" Value="White"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="B" Property="Background" Value="#FF3A3A3C"/>
              <Setter TargetName="T" Property="Foreground" Value="White"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Btn" TargetType="Button">
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="B" Background="#FF3A3A3C" CornerRadius="8" Padding="14,7">
            <TextBlock Text="{TemplateBinding Content}" Foreground="White" FontSize="13" HorizontalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="B" Property="Background" Value="#FF48484A"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="B" Property="Background" Value="#FF636366"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.4"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</Window.Resources>

<Grid Margin="20,16,20,16">
  <Grid.RowDefinitions>
    <RowDefinition Height="Auto"/>
    <RowDefinition Height="Auto"/>
    <RowDefinition Height="*"/>
  </Grid.RowDefinitions>

  <StackPanel Grid.Row="0">
    <TextBlock Text="Настройки" FontSize="24" FontWeight="SemiBold" Foreground="White"/>
    <TextBlock x:Name="SrcText" Foreground="{StaticResource Muted}" TextWrapping="Wrap" FontSize="12" Margin="0,2,0,0"/>
  </StackPanel>

  <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,14,0,12">
    <RadioButton x:Name="TabGeneral" Tag="PageGeneral" Content="Общие" Style="{StaticResource Tab}" IsChecked="True"/>
    <RadioButton x:Name="TabNotif" Tag="PageNotif" Content="Уведомления" Style="{StaticResource Tab}"/>
    <RadioButton x:Name="TabClip" Tag="PageClip" Content="Буфер" Style="{StaticResource Tab}"/>
    <RadioButton x:Name="TabApps" Tag="PageApps" Content="Приложения" Style="{StaticResource Tab}"/>
  </StackPanel>

  <ScrollViewer x:Name="PageGeneral" Grid.Row="2" VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="0,0,6,0">
<Border Background="{StaticResource Card}" CornerRadius="12" Padding="16,14" Margin="0,0,0,12">
<StackPanel>
<TextBlock Text="ПОЛОЖЕНИЕ" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Muted}" Margin="0,0,0,10"/>
<StackPanel>
<TextBlock Text="Где находится остров" FontSize="14" Foreground="White"/>
<TextBlock Text="«Сбоку» — остров поворачивается и уходит к левому краю, когда на экране открыто другое окно." FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,2,0,8"/>
<WrapPanel>
<RadioButton x:Name="PosCenter" Tag="center" Content="Сверху по центру" Style="{StaticResource Seg}"/>
<RadioButton x:Name="PosLeft" Tag="left" Content="Сбоку при открытом окне" Style="{StaticResource Seg}"/>
</WrapPanel>
</StackPanel>
<Rectangle Height="1" Fill="#FF3A3A3C" Margin="0,10,0,10"/>
<Grid Margin="0,2,0,2">
  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
  <StackPanel Margin="0,0,14,0" VerticalAlignment="Center">
    <TextBlock Text="Закрепить положение" FontSize="14" Foreground="White" TextWrapping="Wrap"/>
    <TextBlock Text="Остров останется там, где он сейчас, и не будет переезжать." FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,2,0,0"/>
  </StackPanel>
  <ToggleButton x:Name="LockChk" Grid.Column="1" Style="{StaticResource Switch}"/>
</Grid>
<Rectangle Height="1" Fill="#FF3A3A3C" Margin="0,10,0,10"/>
<Grid Margin="0,2,0,2">
  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
  <StackPanel Margin="0,0,14,0" VerticalAlignment="Center">
    <TextBlock Text="Прятать в играх" FontSize="14" Foreground="White" TextWrapping="Wrap"/>
    <TextBlock Text="Остров исчезает в играх и полноэкранных окнах и возвращается после них." FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,2,0,0"/>
  </StackPanel>
  <ToggleButton x:Name="GameChk" Grid.Column="1" Style="{StaticResource Switch}"/>
</Grid>
</StackPanel>
</Border><Border Background="{StaticResource Card}" CornerRadius="12" Padding="16,14" Margin="0,0,0,12">
<StackPanel>
<TextBlock Text="РАСКРЫТЫЙ ОСТРОВ" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Muted}" Margin="0,0,0,10"/>
<Grid Margin="0,2,0,2">
  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
  <StackPanel Margin="0,0,14,0" VerticalAlignment="Center">
    <TextBlock Text="Батарея, CPU и RAM" FontSize="14" Foreground="White" TextWrapping="Wrap"/>
    <TextBlock Text="Показывать справа от часов, когда остров раскрыт." FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,2,0,0"/>
  </StackPanel>
  <ToggleButton x:Name="ShowStatsChk" Grid.Column="1" Style="{StaticResource Switch}"/>
</Grid>
<Rectangle Height="1" Fill="#FF3A3A3C" Margin="0,10,0,10"/>
<Grid Margin="0,2,0,2">
  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
  <StackPanel Margin="0,0,14,0" VerticalAlignment="Center">
    <TextBlock Text="Музыкальный плеер" FontSize="14" Foreground="White" TextWrapping="Wrap"/>
    <TextBlock Text="Показывать обложку, название и кнопки управления, когда что-то играет." FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,2,0,0"/>
  </StackPanel>
  <ToggleButton x:Name="ShowMusicChk" Grid.Column="1" Style="{StaticResource Switch}"/>
</Grid>
</StackPanel>
</Border><Border Background="{StaticResource Card}" CornerRadius="12" Padding="16,14" Margin="0,0,0,12">
<StackPanel>
<TextBlock Text="КНОПКА РЯДОМ С ОСТРОВОМ" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Muted}" Margin="0,0,0,10"/>
<StackPanel>
<TextBlock Text="Что делает маленький круглый островок" FontSize="14" Foreground="White"/>
<TextBlock Text="Он стоит справа от главного. Когда остров раскрывается, островок сливается с ним, а в раскрытом острове остаются обе кнопки: 🌙 «Не беспокоить» и 📷 скриншот." FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,2,0,8"/>
<WrapPanel>
<RadioButton x:Name="ActShot" Tag="screenshot" Content="📷  Скриншот" Style="{StaticResource Seg}"/>
<RadioButton x:Name="ActDnd" Tag="dnd" Content="🌙  Не беспокоить" Style="{StaticResource Seg}"/>
</WrapPanel>
<TextBlock x:Name="ActHint" FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0"/>
</StackPanel>
</StackPanel>
</Border>
    </StackPanel>
  </ScrollViewer>

  <ScrollViewer x:Name="PageNotif" Grid.Row="2" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
    <StackPanel Margin="0,0,6,0">
<Border Background="{StaticResource Card}" CornerRadius="12" Padding="16,14" Margin="0,0,0,12">
<StackPanel>
<TextBlock Text="УВЕДОМЛЕНИЯ НА ОСТРОВЕ" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Muted}" Margin="0,0,0,10"/>
<Grid Margin="0,2,0,2">
  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
  <StackPanel Margin="0,0,14,0" VerticalAlignment="Center">
    <TextBlock Text="Показывать текст уведомлений" FontSize="14" Foreground="White" TextWrapping="Wrap"/>
    <TextBlock Text="Заголовок и текст входящих уведомлений. Если выключить, остров просто не будет их показывать." FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,2,0,0"/>
  </StackPanel>
  <ToggleButton x:Name="ShowNotifTextChk" Grid.Column="1" Style="{StaticResource Switch}"/>
</Grid>
<Rectangle Height="1" Fill="#FF3A3A3C" Margin="0,10,0,10"/>
<Grid Margin="0,2,0,2">
  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
  <StackPanel Margin="0,0,14,0" VerticalAlignment="Center">
    <TextBlock Text="Не беспокоить" FontSize="14" Foreground="White" TextWrapping="Wrap"/>
    <TextBlock Text="Остров не показывает уведомления. Включить на время можно через 🌙 в раскрытом острове." FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,2,0,0"/>
  </StackPanel>
  <ToggleButton x:Name="DndChk" Grid.Column="1" Style="{StaticResource Switch}"/>
</Grid>
</StackPanel>
</Border><Border Background="{StaticResource Card}" CornerRadius="12" Padding="16,14" Margin="0,0,0,12">
<StackPanel>
<TextBlock Text="БАННЕРЫ WINDOWS" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Muted}" Margin="0,0,0,10"/>
<Grid Margin="0,2,0,2">
  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
  <StackPanel Margin="0,0,14,0" VerticalAlignment="Center">
    <TextBlock Text="Скрывать обычные баннеры" FontSize="14" Foreground="White" TextWrapping="Wrap"/>
    <TextBlock x:Name="HideDesc" Text="Windows не покажет свои всплывающие окна для приложений, отмеченных на вкладке «Приложения»." FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,2,0,0"/>
  </StackPanel>
  <ToggleButton x:Name="HideChk" Grid.Column="1" Style="{StaticResource Switch}"/>
</Grid>
<Rectangle Height="1" Fill="#FF3A3A3C" Margin="0,10,0,10"/>
<WrapPanel>
<Button x:Name="BtnRestore" Content="Вернуть баннеры Windows" Style="{StaticResource Btn}" Margin="0,0,8,0"/>
<Button x:Name="BtnTest" Content="Тестовое уведомление" Style="{StaticResource Btn}" Margin="0"/>
</WrapPanel>
</StackPanel>
</Border>
    </StackPanel>
  </ScrollViewer>

  <ScrollViewer x:Name="PageClip" Grid.Row="2" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
    <StackPanel Margin="0,0,6,0">
<Border Background="{StaticResource Card}" CornerRadius="12" Padding="16,14" Margin="0,0,0,12">
<StackPanel>
<TextBlock Text="БУФЕР ОБМЕНА" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Muted}" Margin="0,0,0,10"/>
<Grid Margin="0,2,0,2">
  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
  <StackPanel Margin="0,0,14,0" VerticalAlignment="Center">
    <TextBlock Text="Сообщения «Скопировано» и «Вставлено»" FontSize="14" Foreground="White" TextWrapping="Wrap"/>
    <TextBlock Text="Короткая подсказка на острове, когда вы копируете или вставляете текст." FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,2,0,0"/>
  </StackPanel>
  <ToggleButton x:Name="CopyMsgChk" Grid.Column="1" Style="{StaticResource Switch}"/>
</Grid>
<Rectangle Height="1" Fill="#FF3A3A3C" Margin="0,10,0,10"/>
<Grid Margin="0,2,0,2">
  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
  <StackPanel Margin="0,0,14,0" VerticalAlignment="Center">
    <TextBlock Text="Хранить историю на диске" FontSize="14" Foreground="White" TextWrapping="Wrap"/>
    <TextBlock Text="История останется после перезапуска. Выключите, если копируете пароли." FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,2,0,0"/>
  </StackPanel>
  <ToggleButton x:Name="ClipChk" Grid.Column="1" Style="{StaticResource Switch}"/>
</Grid>
<Rectangle Height="1" Fill="#FF3A3A3C" Margin="0,10,0,10"/>
<WrapPanel>
<Button x:Name="BtnClipClear" Content="Очистить историю" Style="{StaticResource Btn}" Margin="0"/>
</WrapPanel>
</StackPanel>
</Border>
    </StackPanel>
  </ScrollViewer>

  <Grid x:Name="PageApps" Grid.Row="2" Visibility="Collapsed">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <TextBlock Grid.Row="0" Text="Уведомления от выбранных приложений показываются на острове. Выключите приложение, и остров будет его игнорировать." FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,10"/>
    <Border Grid.Row="1" Background="{StaticResource Card}" CornerRadius="10" Padding="10,4" Margin="0,0,0,10">
      <Grid>
        <TextBlock Text="🔍" FontSize="13" VerticalAlignment="Center" Margin="0,0,0,0"/>
        <TextBox x:Name="Filter" Margin="26,0,0,0" Padding="2,6" Background="Transparent" Foreground="White" BorderThickness="0" CaretBrush="White" FontSize="13" ToolTip="Поиск по названию приложения"/>
      </Grid>
    </Border>
    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
      <StackPanel x:Name="AppList" Margin="0,0,6,0"/>
    </ScrollViewer>
    <WrapPanel Grid.Row="3" Margin="0,12,0,0">
      <Button x:Name="BtnAll" Content="Включить все" Style="{StaticResource Btn}" Margin="0,0,8,0"/>
      <Button x:Name="BtnNone" Content="Выключить все" Style="{StaticResource Btn}" Margin="0"/>
    </WrapPanel>
  </Grid>
</Grid>
</Window>
